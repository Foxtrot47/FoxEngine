{
  "name": "FoxEngine Showcase",
  "startupScene": "Assets/Scenes/showcase.json",
  "scenes": [
    "Assets/Scenes/showcase.json",
    "Assets/Scenes/bistro.json",
    "Assets/Scenes/suntemple.json",
    "Assets/Scenes/specgloss.json",
    "Assets/Scenes/actors.json",
    "Assets/Scenes/shooting_range.json",
    "Assets/Scenes/monza.json",
    "Assets/Scenes/roadatlanta.json"
  ],
  "autoload": [
    "Assets/Scripts/Game/PlayerController.lua",
    "Assets/Scripts/Game/PauseMenu.lua"
  ],
  "input": {
    "move_forward": ["W", "Up"],
    "move_back": ["S", "Down"],
    "move_left": ["A", "Left"],
    "move_right": ["D", "Right"],
    "move_up": ["E"],
    "move_down": ["Q"],
    "sprint": ["Shift", "Gamepad.LeftThumb"],
    "jump": ["Space", "Gamepad.A"],
    "look": ["MouseRight"],
    "toggle_walk": ["Tab", "Gamepad.Y"],
    "pause": ["Escape", "Gamepad.Start"],
    "fire": ["MouseLeft", "Gamepad.RightShoulder"],
    "reset": ["R", "Gamepad.Back"],
    "drive_throttle": ["W", "Up"],
    "drive_brake": ["S", "Down"],
    "drive_left": ["A", "Left"],
    "drive_right": ["D", "Right"],
    "drive_handbrake": ["Space", "Gamepad.A"],
    "drive_toggle_auto": ["M", "Gamepad.X"],
    "drive_shift_up": ["E", "Gamepad.RightShoulder"],
    "drive_shift_down": ["Q", "Gamepad.LeftShoulder"],
    "drive_tc": ["T"],
    "drive_abs": ["B"]
  },
  "window": {
    "width": 1280,
    "height": 720
  }
}
